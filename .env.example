# Industrial Safety Intelligence Platform Configuration
ENVIRONMENT=development
PROJECT_NAME="Industrial Safety Intelligence Platform"
API_V1_STR="/api"

# Database Configuration
# Default to SQLite for zero-setup local dev/test or PostgreSQL:
# postgresql://postgres:postgres@localhost:5432/safety_intel
DATABASE_URL=sqlite:///./industrial_safety.db

# Detection & SLA Thresholds
ACK_SLA_CRITICAL_SECONDS=300
ACK_SLA_HIGH_SECONDS=900
ACK_SLA_MEDIUM_SECONDS=1800
ACK_SLA_LOW_SECONDS=3600

# Anomaly Detection Parameters
ALARM_FLOOD_THRESHOLD=10
ALARM_FLOOD_WINDOW_MINUTES=10
REPEATED_UNSAFE_WINDOW_HOURS=24
REPEATED_UNSAFE_MIN_EVENTS=3
NUISANCE_ALARM_MIN_COUNT=15
NUISANCE_MAX_INCIDENT_RATE=0.05

# Synthetic Data Generation Defaults
RANDOM_SEED=20261022
GEN_PLANTS=4
GEN_MACHINES=60
GEN_ALARMS=200
GEN_EVENTS=50000
GEN_DAYS=30
