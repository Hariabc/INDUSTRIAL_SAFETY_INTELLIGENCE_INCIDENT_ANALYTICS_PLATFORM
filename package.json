{
  "name": "industrial-safety-intelligence-platform",
  "version": "1.0.0",
  "description": "Turning Industrial Safety Events into Actionable Intelligence.",
  "scripts": {
    "frontend:install": "cd frontend && npm install",
    "frontend:build": "cd frontend && npm run build",
